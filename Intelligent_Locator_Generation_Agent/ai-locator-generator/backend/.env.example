# openai | anthropic | langflow | mock
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: OpenAI-compatible base URL (e.g. local Ollama or Groq endpoint)
OPENAI_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# LangFlow (hosted in LangFlow Desktop, localhost:7860 by default)
# Import langflow/flows/ai_locator_analyzer.json and copy the flow id here.
LANGFLOW_BASE_URL=http://localhost:7860
LANGFLOW_FLOW_ID=
LANGFLOW_API_KEY=
LANGFLOW_TIMEOUT_MS=120000

PORT=4000
