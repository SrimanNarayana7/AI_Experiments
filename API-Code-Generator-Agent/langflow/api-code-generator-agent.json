      {
        "data": {
          "id": "OpenAPISpecParser-abc12",
          "node": {
            "base_classes": ["Message"],
            "beta": false,
            "conditional_paths": [],
            "custom_fields": {},
            "description": "Parses and normalizes an OpenAPI/Swagger specification.",
            "display_name": "OpenAPI Spec Parser",
            "documentation": "",
            "edited": false,
            "field_order": ["spec_url", "spec_file"],
            "frozen": false,
            "icon": "braces",
            "legacy": false,
            "lf_version": "1.11.0",
            "metadata": {
              "code_hash": "custom-apigen-parser",
              "module": "custom_components.openapi_spec_parser"
            },
            "minimized": false,
            "output_types": [],
            "outputs": [
              {
                "allows_loop": false,
                "cache": true,
                "display_name": "Manifest",
                "group_outputs": false,
                "method": "build_manifest",
                "name": "manifest",
                "selected": "Message",
                "tool_mode": true,
                "types": ["Message"],
                "value": "__UNDEFINED__"
              },
              {
                "allows_loop": false,
                "cache": true,
                "display_name": "Error",
                "group_outputs": false,
                "method": "build_error",
                "name": "error",
                "selected": "Message",
                "tool_mode": true,
                "types": ["Message"],
                "value": "__UNDEFINED__"
              }
            ],
            "pinned": false,
            "template": {
              "_type": "Component",
              "code": {
                "advanced": true,
                "dynamic": true,
                "multiline": true,
                "name": "code",
                "required": true,
                "show": true,
                "type": "code",
                "value": "import json\nimport re\nfrom typing import Any\n\nimport httpx\nimport yaml\n\nfrom lfx.custom.custom_component.component import Component\nfrom lfx.io import HandleInput, MessageTextInput, Output\nfrom lfx.schema.message import Message\n\n\nclass OpenAPISpecParserComponent(Component):\n    display_name = \"OpenAPI Spec Parser\"\n    description = \"Parses and normalizes an OpenAPI/Swagger specification.\"\n    icon = \"braces\"\n\n    inputs = [\n        MessageTextInput(name=\"spec_url\", display_name=\"Specification URL\", info=\"URL to an OpenAPI/Swagger JSON or YAML file.\"),\n        HandleInput(name=\"spec_file\", display_name=\"Uploaded File\", input_types=[\"Message\"], info=\"Uploaded OpenAPI/Swagger file content.\"),\n    ]\n\n    outputs = [\n        Output(display_name=\"Manifest\", name=\"manifest\", method=\"build_manifest\"),\n        Output(display_name=\"Error\", name=\"error\", method=\"build_error\"),\n    ]\n\n    def _load(self) -> str:\n        url = (self.spec_url or \"\").strip()\n        file_content = self.spec_file.text if isinstance(self.spec_file, Message) else \"\"\n        if url:\n            response = httpx.get(url, timeout=30, follow_redirects=True)\n            response.raise_for_status()\n            return response.text\n        if file_content:\n            return file_content\n        return \"\"\n\n    def _parse(self, raw: str) -> dict:\n        text = raw.lstrip()\n        if text.startswith(\"{\") or text.startswith(\"[\"):\n            return json.loads(text)\n        return yaml.safe_load(text)\n\n    def _extract(self, doc: dict) -> dict:\n        endpoints = []\n        paths = doc.get(\"paths\", {})\n        methods = {\"get\", \"post\", \"put\", \"patch\", \"delete\", \"options\", \"head\", \"trace\"}\n        for path, item in paths.items():\n            if not isinstance(item, dict):\n                continue\n            for method in methods:\n                op = item.get(method)\n                if not isinstance(op, dict):\n                    continue\n                responses = []\n                for status, resp in (op.get(\"responses\") or {}).items():\n                    if isinstance(resp, dict):\n                        responses.append({\"status\": status, \"description\": resp.get(\"description\")})\n                endpoints.append({\n                    \"path\": path,\n                    \"method\": method.upper(),\n                    \"operationId\": op.get(\"operationId\"),\n                    \"summary\": op.get(\"summary\"),\n                    \"tags\": op.get(\"tags\", []),\n                    \"parameters\": op.get(\"parameters\", []),\n                    \"requestBody\": op.get(\"requestBody\"),\n                    \"responses\": responses,\n                    \"security\": op.get(\"security\"),\n                })\n\n        servers = []\n        if isinstance(doc.get(\"servers\"), list):\n            servers = [s.get(\"url\") for s in doc[\"servers\"] if isinstance(s, dict) and s.get(\"url\")]\n        elif isinstance(doc.get(\"host\"), str):\n            scheme = (doc.get(\"schemes\") or [\"https\"])[0]\n            base_path = doc.get(\"basePath\", \"\")\n            servers = [f\"{scheme}://{doc['host']}{base_path}\".rstrip(\"/\")]\n\n        spec_format = \"openapi3\" if \"openapi\" in doc else \"swagger2\"\n        format_version = doc.get(\"openapi\") or doc.get(\"swagger\")\n        info = doc.get(\"info\") or {}\n\n        return {\n            \"spec\": {\n                \"title\": info.get(\"title\", \"Untitled API\"),\n                \"version\": info.get(\"version\", \"0.0.0\"),\n                \"format\": spec_format,\n                \"formatVersion\": format_version,\n            },\n            \"servers\": servers,\n            \"securitySchemes\": list((doc.get(\"components\") or {}).get(\"securitySchemes\", {}).keys()) or list((doc.get(\"securityDefinitions\") or {}).keys()),\n            \"endpoints\": endpoints,\n        }\n\n    def build_manifest(self) -> Message:\n        raw = self._load()\n        if not raw:\n            return Message(text=\"No OpenAPI specification provided. Upload a JSON/YAML file or provide a specification URL.\")\n        try:\n            doc = self._parse(raw)\n            manifest = self._extract(doc)\n            return Message(text=json.dumps(manifest, ensure_ascii=False))\n        except Exception as exc:\n            return Message(text=f\"Invalid specification: {exc}\")\n\n    def build_error(self) -> Message:\n        return Message(text=\"\")\n"
              },
              "spec_url": {
