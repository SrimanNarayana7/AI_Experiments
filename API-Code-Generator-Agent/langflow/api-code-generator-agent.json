                "input_types": ["Message"],
                "name": "spec_file",
                "required": false,
                "show": true,
                "type": "other",
                "value": ""
              }
            },
            "tool_mode": false
          },
          "selected_output": "manifest",
          "showNode": true,
          "type": "OpenAPISpecParser"
        },
