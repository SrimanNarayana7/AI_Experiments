# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/api_code_generator

# Langflow orchestration layer
LANGFLOW_BASE_URL=http://localhost:7860
LANGFLOW_FLOW_ID=
LANGFLOW_API_KEY=

# HTTP server
PORT=4000
FRONTEND_URL=http://localhost:5173

# Local filesystem storage (uploads + generated projects)
STORAGE_PATH=../storage
MAX_UPLOAD_SIZE=5242880

# Langflow request timeout in milliseconds
LANGFLOW_TIMEOUT_MS=120000
