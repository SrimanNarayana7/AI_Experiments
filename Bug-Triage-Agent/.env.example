# Langflow server origin, e.g. http://localhost:7860
VITE_LANGFLOW_BASE_URL=http://localhost:7860

# Bug Triage workflow id in Langflow
VITE_LANGFLOW_FLOW_ID=8886e711-61a0-43f3-b70f-ddb7efab335e

# ------------------------------------------------------------------
# SECURITY: choose ONE of the two options below, never both.
# ------------------------------------------------------------------

# Option A — browser-safe API key (only if your Langflow instance is
# configured for browser-safe authentication, e.g. a dev-only instance
# on localhost). NEVER put a real production secret here.
VITE_LANGFLOW_API_KEY=your-langflow-api-key

# Option B — secure proxy that holds the API key server-side.
# The proxy must accept POST {proxy}/api/v1/run/{FLOW_ID} and forward to
# Langflow, injecting the x-api-key header. Uncomment to use.
# VITE_LANGFLOW_PROXY_URL=
